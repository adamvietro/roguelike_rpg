// Guaranteed starting inventory per class, granted once right after
// spawn_player (see spawner::grant_starting_items). Item names must
// exactly match a Template.name in template.ron - this works even for
// prefab_only weapons or levels:[] battle-loot techniques, since it
// bypasses all the normal spawn pools and grants exactly what's listed.
//
// Every class gets 3 Healing Potions now, Barbarian included - a
// class-survivability simulation (10 headless runs per class, see
// docs/journal.md) found only 3/50 runs reaching the first shop at all
// once ambient Potions/Maps were pulled off the dungeon floor, with
// Mage dying 10/10. A single starting Potion (or, for Barbarian,
// none at all) was nowhere near enough sustain to bridge the gap to the
// chest/shop now that floor-scattered healing is gone.
StartingKits(
    kits: [
        StartingKit(
            // Barbarian has the best raw stats (highest HP, only class
            // with a positive Defense) but still died in the same
            // simulation without any guaranteed healing at all - see
            // this file's own doc comment above.
            class: "Barbarian",
            items: [ "Healing Potion", "Healing Potion", "Healing Potion" ],
        ),
        StartingKit(
            // Mage is squishy (Defense -1, no innate weapon damage) and
            // otherwise starts completely empty-handed relying on random
            // battle loot for any technique or weapon at all - this kit
            // exists so a fresh Mage run is actually survivable from turn
            // one, without guaranteeing an offensive technique (Fireball
            // is still loot-only).
            class: "Mage",
            items: [
                "Healing Potion", "Healing Potion", "Healing Potion",
                "Invisible Cloak", "Ice Armor",
            ],
        ),
        StartingKit(
            // Rogue starts with just enough to make Stealth ambushes
            // testable/usable from turn one - Garrote, Dodge, and a
            // Dagger are all still left to loot/the guarded fortress
            // room, same as Barbarian finding its Sword tier there.
            class: "Rogue",
            items: [ "Healing Potion", "Healing Potion", "Healing Potion", "Stealth" ],
        ),
        StartingKit(
            // Debug class - see spawner::class_base_stats and
            // main.rs's hidden D-key class-select shortcut. Items just
            // stack when listed more than once (see
            // Templates::spawn_named_item), so "Next Level" x2 is simply
            // listed twice - no special count field needed.
            class: "Debug",
            items: [ "Victory", "Defeat", "Next Level", "Next Level", "Battle 4" ],
        ),
        StartingKit(
            // Amazon starts with one of each of its two out-of-combat
            // tools (Trap, and now 3 Healing Potions like every class)
            // plus its damage-reduction technique - Throw Spear and
            // Poison Spear are left to loot/the guarded fortress room,
            // same pattern as every other class's kit.
            class: "Amazon",
            items: [
                "Healing Potion", "Healing Potion", "Healing Potion",
                "Trap", "Battle Cry",
            ],
        ),
        StartingKit(
            // Hunter starts with two Freeze Traps (its signature
            // out-of-combat tool, worth having more than one of right
            // away), 3 Healing Potions, and one Shoot - Poison Shot,
            // Stun, and Feint are left to loot/the guarded fortress
            // room, same pattern as every other class's kit.
            class: "Hunter",
            items: [
                "Freeze Trap", "Freeze Trap",
                "Healing Potion", "Healing Potion", "Healing Potion",
                "Shoot",
            ],
        ),
    ],
)
