Templates(
    entities : [
        Template(
            entity_type: Item,
            name : "Healing Potion", glyph : '!', levels : [ 0, 1, 2 ],
            effect: Some(Healing(6)),
            frequency: 2
        ),
        Template(
            entity_type: Item,
            name : "Dungeon Map", glyph : '{', levels : [ 0, 1, 2 ],
            effect: Some(MagicMap),
            frequency: 1
        ),
        Template(
            // prefab treasure only - prefab_only:true means this never
            // appears in the general ambient spawn pool, only via a
            // prefab's guaranteed 'S' marker (see spawn_prefab_weapon).
            // class: Barbarian - a Mage will never find one of these here;
            // it shares its guaranteed slot with the 3 Staff tiers below
            // instead. levels still gates which dungeon levels this tier
            // is eligible to be picked on.
            entity_type: Item,
            name : "Rusty Sword", glyph: 's', levels: [ 0],
            frequency: 1,
            base_damage: Some(1),
            class: Some("Barbarian"),
            prefab_only: true
        ),
        Template(
            entity_type: Item,
            name : "Shiny Sword", glyph: 'S', levels: [ 1 ],
            frequency: 1,
            base_damage: Some(2),
            class: Some("Barbarian"),
            prefab_only: true
        ),
        Template(
            entity_type: Item,
            name : "Huge Sword", glyph: '/', levels: [ 1, 2 ],
            frequency: 1,
            base_damage: Some(3),
            class: Some("Barbarian"),
            prefab_only: true
        ),
        Template(
            // Mage's weapon tier, parallel to the 3 Swords above - same
            // guaranteed prefab slot, same level gating, but class: Mage
            // so a Barbarian will never find one of these instead. Glyphs
            // are 0/1/2 placeholders (same idea as the class-select letter
            // icons) until real sprite art exists.
            entity_type: Item,
            name : "Wooden Staff", glyph: '0', levels: [ 0 ],
            frequency: 1,
            base_damage: Some(1),
            class: Some("Mage"),
            prefab_only: true
        ),
        Template(
            entity_type: Item,
            name : "Silver Staff", glyph: '1', levels: [ 1 ],
            frequency: 1,
            base_damage: Some(2),
            class: Some("Mage"),
            prefab_only: true
        ),
        Template(
            entity_type: Item,
            name : "Arcane Staff", glyph: '2', levels: [ 1, 2 ],
            frequency: 1,
            base_damage: Some(3),
            class: Some("Mage"),
            prefab_only: true
        ),
        Template(
            // Battle loot only - levels:[] means this never appears as a
            // normal floor spawn, only via grant_random_battle_loot.
            entity_type: Item,
            name : "Deathblow", glyph: '?', levels: [ ],
            technique: Some(DamageMultiplier(2)),
            frequency: 0,
            class: Some("Barbarian"),
            description: Some("A single devastating strike dealing double your normal attack damage.")
        ),
        Template(
            entity_type: Item,
            name : "Quick Attack", glyph: '?', levels: [ ],
            technique: Some(MultiHit(2)),
            frequency: 0,
            class: Some("Barbarian"),
            description: Some("Strike twice in the same turn before the enemy can react.")
        ),
        Template(
            entity_type: Item,
            name : "Counter Attack", glyph: '?', levels: [ ],
            technique: Some(Counter(chance_percent: 65, multiplier: 3)),
            frequency: 0,
            class: Some("Barbarian"),
            description: Some("Skip your attack for a 65% chance to deal 3x damage back when the enemy strikes you.")
        ),
        Template(
            // Replaces the old "Garrote" technique - same DamageOverTime
            // effect, just a new name.
            entity_type: Item,
            name : "Rend", glyph: '?', levels: [ ],
            technique: Some(DamageOverTime(damage: 2, turns: 3)),
            frequency: 0,
            class: Some("Barbarian"),
            description: Some("Wounds the enemy for 2 damage per turn over the next 3 turns.")
        ),
        Template(
            // Mage battle loot - same levels:[]/frequency:0 pattern as the
            // Barbarian techniques above (battle-loot only).
            entity_type: Item,
            name : "Fireball", glyph: '?', levels: [ ],
            technique: Some(FlatDamage(2)),
            frequency: 0,
            class: Some("Mage"),
            description: Some("Hurls a bolt of fire for 2 damage, plus your staff's damage.")
        ),
        Template(
            entity_type: Item,
            name : "Burn", glyph: '?', levels: [ ],
            technique: Some(DamageOverTime(damage: 1, turns: 3)),
            frequency: 0,
            class: Some("Mage"),
            description: Some("Sets the enemy alight for 1 damage per turn over the next 3 turns.")
        ),
        Template(
            // Ice Armor is used out of combat, like Invisible Cloak -
            // "Mages buff before battle." +2 Defense for the next 10
            // enemy hits actually landed (counts down on hits absorbed,
            // not turns) - see components::IceArmored /
            // battle::resolve_enemy_attack. Numbers are a first guess,
            // easy to retune here with no code change.
            entity_type: Item,
            name : "Ice Armor", glyph: '?', levels: [ ],
            effect: Some(IceArmor(defense_bonus: 2, attacks: 10)),
            frequency: 0,
            class: Some("Mage"),
            description: Some("Encases you in ice, adding 2 Defense for your next 10 hits taken. Use it before you walk into a fight.")
        ),
        Template(
            // Battle loot only (levels:[]/frequency:0) - NOT an ambient
            // floor spawn. grant_random_battle_loot filters its candidate
            // pool by class alone (not by BattleItem/technique/effect), so
            // this needed no code changes to become loot - only data.
            // Not a BattleItem/Technique - it stays off the battle menu
            // and shows up in the ordinary dungeon-view item list once
            // won, since it's explicitly an out-of-combat ability (see
            // components::Invisible / systems/player_input.rs).
            entity_type: Item,
            name : "Invisible Cloak", glyph: '?', levels: [ ],
            effect: Some(Invisibility(20)),
            frequency: 0,
            class: Some("Mage"),
            description: Some("Wear it to become unseen for 20 moves - enemies can't touch you, but you can't push past them either.")
        ),
        Template(
